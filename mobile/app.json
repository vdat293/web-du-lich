{
  "expo": {
    "name": "Aoklevart",
    "slug": "aoklevart-mobile",
    "version": "1.0.0",
    "icon": "./assets/logo-aoklevart-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "aoklevart",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aoklevart.mobile"
    },
    "android": {
      "package": "com.aoklevart.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-aoklevart-icon.png",
        "backgroundColor": "#FAF8F5"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo-aoklevart-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép Aoklevart sử dụng Face ID để mở khóa phiên đăng nhập."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-aoklevart-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ]
  }
}
