{
  "expo": {
    "name": "Aoklevart",
    "slug": "aoklevart-mobile",
    "version": "1.0.0",
    "icon": "./assets/logo-aoklevart-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "aoklevart",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aoklevart.mobile",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "com.aoklevart.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-aoklevart-icon.png",
        "backgroundColor": "#FAF8F5"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo-aoklevart-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép Aoklevart sử dụng Face ID để mở khóa phiên đăng nhập."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-aoklevart-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "cf595dc4-dfcb-4d64-8f9f-0e3b162ee06c"
      }
    },
    "owner": "nexpodev293"
  }
}
